# What eidolon uses of pyrage, which ships without type information.
from collections.abc import Sequence

from pyrage import x25519 as x25519

class RecipientError(Exception): ...
class IdentityError(Exception): ...
class EncryptError(Exception): ...
class DecryptError(Exception): ...

def encrypt(plaintext: bytes, recipients: Sequence[x25519.Recipient], armored: bool = False) -> bytes: ...
def encrypt_file(infile: str, outfile: str, recipients: Sequence[x25519.Recipient], armored: bool = False) -> None: ...
def decrypt(ciphertext: bytes, identities: Sequence[x25519.Identity]) -> bytes: ...
