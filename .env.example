# 复制为 .env 后填写。docker compose up 会把它传给后端。

# 对话模型。接口类型 CHAT_LLM_PROTOCOL 三选一（不填为 chat-completions）：
#   chat-completions  OpenAI 兼容的 Chat Completions 接口（请求 {地址}/chat/completions）
#   responses         OpenAI Responses 接口（请求 {地址}/responses）
#   anthropic         Anthropic Messages 接口（请求 {地址}/messages，例如地址填 https://api.anthropic.com/v1）
# 对话模型必须支持流式输出和工具调用：后端启动时会发一次很小的检查请求，不满足就拒绝启动并说明原因
CHAT_LLM_PROTOCOL=
CHAT_LLM_BASE_URL=https://api.openai.com/v1
CHAT_LLM_API_KEY=
CHAT_LLM_MODEL=
# 每次回复的长度上限（可选，单位 token）。Anthropic 接口必须有上限，不填时为 16384；另两种接口不填就不限制
CHAT_LLM_MAX_TOKENS=

# 后台模型：在对话后抽取关于用户的记忆，也用来生成人设初稿，接口类型同样三选一。
# 每一项都可以不填，不填的沿用对话模型的设置（包括接口类型）；例如只填 BACKGROUND_LLM_MODEL，就是在同一个服务上换一个便宜的模型。
# 换到另一种接口的服务时，记得同时填 BACKGROUND_LLM_PROTOCOL
BACKGROUND_LLM_PROTOCOL=
BACKGROUND_LLM_BASE_URL=
BACKGROUND_LLM_API_KEY=
BACKGROUND_LLM_MODEL=
BACKGROUND_LLM_MAX_TOKENS=

# 语音通话：Soniox（语音识别）和 Fish Audio（语音合成）。两项都填了才能语音通话，否则只能文字对话
SONIOX_API_KEY=
FISH_AUDIO_API_KEY=
# Fish Audio 的合成模型（可选）。默认 s2.1-pro-free 不消耗 API 额度；有额度时可改用 s2.1-pro 等付费模型
FISH_AUDIO_MODEL=

# WebRTC 的 STUN/TURN 服务器（可选，默认用 Google 的公共 STUN）。
# 逗号分隔的地址，或 JSON 列表（TURN 需要 username 和 credential），例如：
# EIDOLON_ICE_SERVERS=[{"urls":["turn:turn.example.com:3478"],"username":"u","credential":"p"}]
EIDOLON_ICE_SERVERS=

# 硅基流动：Qwen3-Embedding 做向量化（导入剧情库时需要），Qwen3-Reranker 做对话中检索结果的重排
SILICONFLOW_API_KEY=
# 向量化模型（可选，默认 Qwen/Qwen3-Embedding-0.6B）。更换后需要重新导入剧情库
EMBEDDING_MODEL=
# 重排模型（可选，默认 Qwen/Qwen3-Reranker-0.6B）
RERANK_MODEL=
# 硅基流动的接口地址（可选，默认 https://api.siliconflow.cn/v1）
SILICONFLOW_BASE_URL=

# 对话中的检索判断：Jev，通过 Vercel AI Gateway 调用。
# 和 SILICONFLOW_API_KEY 都填了，角色才会在对话中检索剧情、角色资料和记忆（也才会记住用户说过的事），否则只凭人设回复
AI_GATEWAY_API_KEY=
# Jev 在 Vercel AI Gateway 上的模型名（填了 AI_GATEWAY_API_KEY 时必填）
JEV_MODEL=
# Vercel AI Gateway 的接口地址（可选，默认 https://ai-gateway.vercel.sh/v1）
AI_GATEWAY_BASE_URL=
